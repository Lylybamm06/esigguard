# Copier ce fichier en ".env" (à la racine de backend/) et renseigner les vraies valeurs.
# Le fichier .env réel ne doit JAMAIS être commité (voir .gitignore).

# Secret de signature des tokens de session (JWT). À générer toi-même, ne pas
# réutiliser une valeur d'exemple trouvée en ligne :
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_generate_a_real_random_value

# Base de données : SQLite, fichier local (backend/esigguard.db par défaut),
# créé automatiquement au démarrage de l'API. Rien à installer ni configurer.
# Décommenter uniquement pour changer le nom/emplacement du fichier :
# SQLITE_DB_FILE=esigguard.db

# Non utilisées par le pipeline actuel (le scoring se fait en local, voir
# data-ml/README.md) — gardées pour référence si services/ssh_transfer.py
# est un jour reconnecté à une VM d'analyse externe.
SSH_HOST=your.vm.ip.address
SSH_USER=your_ssh_user
SSH_PASSWORD=your_ssh_password
